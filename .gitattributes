# Normalize line endings to LF in the repository
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary

# Keep docs and repo files out of GitHub's language stats
docs/** linguist-documentation
